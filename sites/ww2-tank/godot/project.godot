config_version=5

[application]

config/name="二战：装甲战线"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/size/window_min_width=640
window/size/window_min_height=400
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[importer_defaults]

scene={
"gltf/embedded_image_handling": 2,
"meshes/generate_lods": false
}

[input]

tank_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
tank_reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
tank_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
tank_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
tank_fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.27, 0.29, 0.23, 1)
